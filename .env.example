# Backend Configuration
FLASK_APP=backend/app/app.py
FLASK_ENV=development
FLASK_DEBUG=true
DATABASE_URL=sqlite:///backend/instance/app.db

# Frontend Configuration
QUASAR_DEV_HOST=localhost
QUASAR_DEV_PORT=8080
VUE_APP_API_BASE_URL=http://localhost:5000/api

# Electron Configuration
PYTHON_EXECUTABLE=app.exe
PYTHON_ARGS=--headless
DEBUGGING=false

# Security
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Development
DEV=true
APP_URL=http://localhost:8080

# Build Configuration  
QUASAR_ELECTRON_PRELOAD_FOLDER=../electron
QUASAR_ELECTRON_PRELOAD_EXTENSION=.js